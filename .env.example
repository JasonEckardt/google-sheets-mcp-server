# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Path to your Google service account JSON key (relative to this folder,
# or an absolute path).
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The spreadsheet to operate on by default (the long ID in a Google Sheets
# URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit).
DEFAULT_SPREADSHEET_ID=your_spreadsheet_id_here
